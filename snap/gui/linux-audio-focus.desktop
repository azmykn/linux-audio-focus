[Desktop Entry]
Name=Linux Audio Focus
GenericName=Audio Focus Manager
Comment=Auto-pause background media when other audio plays, like on phones
Exec=linux-audio-focus
Icon=linux-audio-focus
Terminal=false
Type=Application
Categories=AudioVideo;Audio;Utility;
Keywords=audio;focus;media;mpris;pause;resume;sound;spotify;youtube;vlc;whatsapp;
StartupNotify=false
X-GNOME-Autostart-enabled=true
